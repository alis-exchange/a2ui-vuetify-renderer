{
  "name": "@alis-build/a2ui-vuetify-renderer",
  "version": "0.4.1",
  "description": "A2UI Vuetify Renderer",
  "author": "www.alisx.com",
  "type": "module",
  "main": "./dist/a2ui-vuetify-renderer.umd.cjs",
  "module": "./dist/a2ui-vuetify-renderer.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/a2ui-vuetify-renderer.js",
      "require": "./dist/a2ui-vuetify-renderer.umd.cjs",
      "types": "./dist/index.d.ts"
    },
    "./style.css": "./dist/a2ui-vuetify-renderer.css",
    "./catalog": "./catalog/vuetify-catalog.json"
  },
  "files": [
    "dist",
    "catalog",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build && tsx scripts/check-dist-externals.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "generate:catalog": "tsx scripts/generate-catalog.ts",
    "format": "prettier --write \"src/**/*.{ts,vue,json}\" \"examples/**/*.{ts,vue,json}\" \"scripts/**/*.ts\""
  },
  "keywords": [
    "a2ui",
    "a2ui-renderer",
    "vuetify",
    "a2ui-vue",
    "a2ui-vue-renderer"
  ],
  "homepage": "https://github.com/alis-exchange/a2ui-vuetify-renderer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alis-exchange/a2ui-vuetify-renderer.git"
  },
  "bugs": {
    "url": "https://github.com/alis-exchange/a2ui-vuetify-renderer/issues"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "sass": "^1.108.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "peerDependencies": {
    "@a2ui/web_core": "^0.15.0",
    "vue": "^3.5.35",
    "vuetify": "^4.1.1"
  },
  "devDependencies": {
    "@a2ui/web_core": "^0.15.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-config-vuetify": "^4.7.2",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-oxlint": "^1.92.0",
    "eslint-plugin-playwright": "^2.12.2",
    "eslint-plugin-vue": "^10.12.0",
    "jsdom": "^31.0.0",
    "oxlint": "~1.92.0",
    "prettier": "3.9.10",
    "prettier-plugin-organize-imports": "4.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vite-plugin-dts": "^5.1.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14",
    "vuetify": "^4.3.2"
  },
  "style": "./dist/a2ui-vuetify-renderer.css",
  "packageManager": "pnpm@11.5.2"
}
